# STAGING TEMPLATE ONLY. Never put real credentials in source control.
# Keep the agent feature disabled until migrations, Cognito, TLS and staging checks pass.
NODE_ENV=staging
HOST=0.0.0.0
PORT=8080
DATABASE_URL=REPLACE_WITH_STAGING_POSTGRES_TLS_CONNECTION
NOVA_SECURITY_ADAPTER_MODULE=REPLACE_WITH_ABSOLUTE_PATH_TO_REVIEWED_COGNITO_ADAPTER
NOVA_ALLOWED_ORIGIN=https://REPLACE_WITH_STAGING_HOST
DB_POOL_MAX=10

NOVA_AGENT_FACTORY_ENABLED=false
NOVA_AGENT_PROVIDER=openai
# Leave blank to use the built-in text-only adapter. A custom module must be reviewed
# and must route every external tool/action through invokeTool(toolName, capability, operation).
NOVA_AGENT_EXECUTOR_MODULE=
OPENAI_API_KEY=
OPENAI_MODEL=REPLACE_WITH_A_MODEL_ENABLED_FOR_THE_OPENAI_PROJECT
NOVA_OPENAI_MAX_STEPS=6
NOVA_OPENAI_MAX_OUTPUT_TOKENS=1200
